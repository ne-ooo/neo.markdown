  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "CHANGELOG.md",
    "docs/compatibility.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "docs/efficiency.md",
    "docs/code-blocks.md",
    "docs/code-presentation.md",
    "docs/word-highlighting.md",
    "docs/document-results.md",
    "docs/migration-v3.md",
    "CONTRIBUTING.md",
    "docs/incremental.md",
    "docs/dom-patches.md",
    "docs/worker-sessions.md",
    "docs/application-adapter.md",
    "docs/api-stability.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:conformance": "vitest run test/conformance",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/package/smoke.mjs && tsc -p test/package/tsconfig.json && node test/package/api-surface.mjs",
    "test:integration": "node test/integration/run-highlight.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench",
    "check:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "release:check": "lpm run check:release-metadata && lpm run typecheck && lpm run test:coverage && lpm run build && lpm run test:package && lpm run test:integration && lpm run check:tree-shaking && lpm run security:audit && lpm run security:signatures",
    "prepublishOnly": "lpm run release:check",
    "bench:efficiency": "node test/efficiency.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "security:audit": "lpm audit --level info --fail-on vuln",
    "security:signatures": "lpm audit signatures",
    "test:incremental": "vitest run test/unit/incremental"
  },
  "dependencies": {
    "sanitize-html": "2.17.7"
