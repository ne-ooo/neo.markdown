    "@vitest/coverage-v8": "4.1.11",
    "commonmark-spec": "0.31.2",
    "esbuild": "0.28.2",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^12.0.0",
    "react": "^19.2.4",
    "react-test-renderer": "19.2.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
