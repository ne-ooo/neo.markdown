{
  "name": "@lpm.dev/neo.markdown",
  "version": "2.0.0",
  "description": "Modern, tree-shakeable markdown parser with TypeScript support",
  "keywords": [
    "markdown",
    "parser",
    "commonmark",
    "gfm",
    "github-flavored-markdown",
    "tree-shakeable",
    "typescript",
    "esm",
    "html",
    "marked",
    "markdown-it"
  ],
  "license": "MIT",
  "author": "neo",
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.markdown"
  },
  "homepage": "https://github.com/ne-ooo/neo.markdown#readme",
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.markdown/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sanitized": {
      "import": {
        "types": "./dist/sanitized.d.ts",
        "default": "./dist/sanitized.js"
      },
      "require": {
        "types": "./dist/sanitized.d.cts",
        "default": "./dist/sanitized.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./blocks": {
      "import": {
        "types": "./dist/blocks/index.d.ts",
        "default": "./dist/blocks/index.js"
      },
      "require": {
        "types": "./dist/blocks/index.d.cts",
        "default": "./dist/blocks/index.cjs"
      }
    },
    "./inline": {
      "import": {
        "types": "./dist/inline/index.d.ts",
        "default": "./dist/inline/index.js"
      },
      "require": {
        "types": "./dist/inline/index.d.cts",
        "default": "./dist/inline/index.cjs"
      }
    },
    "./commonmark": {
      "import": {
        "types": "./dist/presets/commonmark.d.ts",
        "default": "./dist/presets/commonmark.js"
      },
      "require": {
        "types": "./dist/presets/commonmark.d.cts",
        "default": "./dist/presets/commonmark.cjs"
      }
    },
    "./gfm": {
      "import": {
        "types": "./dist/presets/gfm.d.ts",
        "default": "./dist/presets/gfm.js"
      },
      "require": {
        "types": "./dist/presets/gfm.d.cts",
        "default": "./dist/presets/gfm.cjs"
      }
    },
    "./plugins/highlight": {
      "import": {
        "types": "./dist/plugins/highlight.d.ts",
        "default": "./dist/plugins/highlight.js"
      },
      "require": {
        "types": "./dist/plugins/highlight.d.cts",
        "default": "./dist/plugins/highlight.cjs"
      }
    },
    "./plugins/embeds": {
      "import": {
        "types": "./dist/plugins/embeds.d.ts",
        "default": "./dist/plugins/embeds.js"
      },
      "require": {
        "types": "./dist/plugins/embeds.d.cts",
        "default": "./dist/plugins/embeds.cjs"
      }
    },
    "./plugins/toc": {
      "import": {
        "types": "./dist/plugins/toc.d.ts",
        "default": "./dist/plugins/toc.js"
      },
      "require": {
        "types": "./dist/plugins/toc.d.cts",
        "default": "./dist/plugins/toc.cjs"
      }
    },
    "./plugins/copy-code": {
      "import": {
        "types": "./dist/plugins/copy-code.d.ts",
        "default": "./dist/plugins/copy-code.js"
      },
      "require": {
        "types": "./dist/plugins/copy-code.d.cts",
        "default": "./dist/plugins/copy-code.cjs"
      }
    },
    "./plugins/embeds/react": {
      "import": {
        "types": "./dist/plugins/embeds/react.d.ts",
        "default": "./dist/plugins/embeds/react.js"
      },
      "require": {
        "types": "./dist/plugins/embeds/react.d.cts",
        "default": "./dist/plugins/embeds/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".lpm",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node test/package/smoke.mjs && tsc -p test/package/tsconfig.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench",
    "check:tree-shaking": "node scripts/verify-tree-shaking.mjs",
    "release:check": "lpm run typecheck && lpm run test:coverage && lpm run build && lpm run test:package && lpm run check:tree-shaking && lpm audit --fail-on=vuln",
    "prepublishOnly": "lpm run release:check"
  },
  "dependencies": {
    "sanitize-html": "2.17.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^3.2.4",
    "commonmark-spec": "0.31.2",
    "esbuild": "0.28.2",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^12.0.0",
    "react": "^19.2.4",
    "react-test-renderer": "19.2.8",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "overrides": {
    "tsup>esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
