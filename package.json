    "markdown",
    "parser",
    "commonmark",
    "gfm",
    "github-flavored-markdown",
    "tree-shakeable",
    "typescript",
    "esm",
    "html",
    "marked",
    "markdown-it"
  ],
  "license": "MIT",
  "author": "neo",
  "repository": {
